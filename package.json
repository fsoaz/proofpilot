{
  "name": "proofpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "26.13.1" },
  "scripts": {
    "dev": "node scripts/start.mts",
    "worker": "node scripts/start.mts --worker-only",
    "dashboard": "node scripts/start.mts --dashboard-only",
    "start": "node scripts/start.mts --production",
    "build": "next build",
    "build:verifier": "podman build -f Containerfile -t localhost/proofpilot-verifier:1.64.1 .",
    "smoke:live": "node scripts/smoke-live.mts",
    "test": "node --test --test-isolation=none runner/*.test.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "diff": "8.0.4",
    "eve": "1.1.0",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
